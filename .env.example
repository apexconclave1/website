# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata and sitemap (e.g. https://apexconclave.in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (free): email the team about new contact messages. Sign up at resend.com with the team inbox.
RESEND_API_KEY=
# Optional sender once a domain is verified in Resend, e.g. Apex Conclave <hello@your-domain>
RESEND_FROM=

# Google Search Console HTML-tag verification code (content="..." value only)
GOOGLE_SITE_VERIFICATION=
